# Neon PostgreSQL connection string with sslmode=require. Never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate a long random secret; keep it stable across deployments.
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Required on Vercel for persistent image uploads. Keep this secret.
BLOB_READ_WRITE_TOKEN=
